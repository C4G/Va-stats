model passkey {
  id           String    @id @db.VarChar(36)
  name         String?   @db.VarChar(255)
  publicKey    String    @db.Text
  userId       String    @db.VarChar(36)
  credentialID String    @db.VarChar(255)
  counter      BigInt
  deviceType   String    @db.VarChar(255)
  backedUp     Boolean
  transports   String?   @db.VarChar(255)
  createdAt    DateTime?
  aaguid       String?   @db.VarChar(255)
  user         user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "passkey_userId_fk")

  @@index([credentialID])
  @@index([userId])
}
